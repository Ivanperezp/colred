    "datos:mix": "node scripts/fetch-mix.mjs",
    "datos:riesgo": "node scripts/fetch-riesgo.mjs",
    "datos:centrales": "node scripts/fetch-centrales-xm.mjs",
    "datos:upme": "node scripts/fetch-upme.mjs",
    "datos:calidad": "node scripts/fetch-calidad.mjs",
    "datos:test": "node scripts/test-parsers.mjs",
    "vivo": "node scripts/vivo.mjs",
    "datos:semanal": "node scripts/fetch-osm.mjs && node scripts/unir-tramos.mjs && node scripts/fetch-centrales-xm.mjs && node scripts/fetch-upme.mjs && node scripts/fetch-calidad.mjs",
    "datos:dane": "python scripts/build_dane.py",
